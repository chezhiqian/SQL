------第一部分：创建表-------

create table Student 
(
  Sno char(7) not null primary key,
  Sname varchar(10) not null unique,
  Ssex char(1) check(Ssex='男' or Ssex='女') default '男',
  Sage tinyint unsigned,
  Sdept char(2)  
);

create table SC 
(
  Sno char(7),
  Cno char(4),
  Grade tinyint unsigned check(Grade between 0 and 100),
  primary key(Sno, Cno),
  foreign key(Sno) references Student(Sno),
  foreign key(Cno) references Course(Cno)  
);
-- 创建 Course 表
create table Course
(
  Cno char(4) not null primary key,
  Cname varchar(20) not null unique,
  Cpno char(4),
  Ccredit decimal(2, 1) check (Ccredit * 10 % 5 = 0),
  foreign key(Cpno) references Course(Cno)
);
